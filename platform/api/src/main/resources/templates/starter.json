  {"id":"order-query","kind":"DATASET","name":"模拟订单查询","content":{"cases":[{"instruction":"查询订单A，返回订单金额和状态","input":{"order_id":"A"},"expected":{"amount":100,"status":"paid"},"timeout_seconds":60}]}},
