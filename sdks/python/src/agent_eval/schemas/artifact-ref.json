{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "artifact-ref",
  "$id": "urn:agenteval:v1:artifact-ref",
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "artifact_id",
    "name",
    "media_type",
    "size_bytes",
    "sha256"
  ],
  "additionalProperties": false
}
