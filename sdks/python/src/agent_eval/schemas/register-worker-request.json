{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "register-worker-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "protocol_version": {
      "const": "1.0"
    },
    "sdk_language": {
      "enum": [
        "JAVA",
        "PYTHON"
      ]
    },
    "sdk_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  },
  "required": [
    "agent_id",
    "agent_version",
    "instance_id",
    "protocol_version",
    "sdk_language",
    "sdk_version",
    "max_concurrency"
  ]
}
