  {"id":"evidence-judge","kind":"EVALUATOR","name":"证据支持度评分范式","content":{"type":"LLM","criterion_id":"evidence_support","required_evidence":["output","expected"],"threshold":0.75,"config":{"rubric":"0分：无支持或矛盾；1分：少量支持；2分：多数支持但关键结论缺失；3分：关键结论有支持；4分：全部重要结论有支持并说明局限。证据不足时返回INSUFFICIENT_EVIDENCE。","scale_max":4}}},
  {"id":"python-amount","kind":"EVALUATOR","name":"自定义金额计算范式","content":{"type":"PYTHON","criterion_id":"custom_amount","required_evidence":["output","expected"],"threshold":1,"config":{"code":"def evaluate(context):\n    actual = context['output'].get('amount')\n    expected = context['expected'].get('amount')\n    if expected is None:\n        return {'status': 'INSUFFICIENT_EVIDENCE', 'score': None, 'reason': '缺少参考金额', 'evidence_refs': []}\n    return {'status': 'SCORED', 'score': 1 if actual == expected else 0, 'reason': '金额比较', 'evidence_refs': ['output']}\n"}}}
