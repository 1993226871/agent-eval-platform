{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trial-context",
  "$id": "urn:agenteval:v1:trial-context",
  "type": "object",
  "properties": {
    "trial_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "input": {},
    "deadline": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "trial_id",
    "instruction",
    "input",
    "deadline"
  ],
  "additionalProperties": false
}
