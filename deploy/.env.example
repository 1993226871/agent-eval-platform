# Generate fresh secrets with scripts/configure_deployment.py; never commit a populated env file.
COMPOSE_PROJECT_NAME=agenteval
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
S3_HTTPS_PORT=9443
PUBLIC_S3_ENDPOINT=https://localhost:9443
TLS_CERT_DIR=/absolute/path/to/tls
DATABASE_PASSWORD=replace-with-generated-secret
S3_ACCESS_KEY=replace-with-generated-access-key
S3_SECRET_KEY=replace-with-generated-secret
MODEL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
MODEL_ENDPOINT_ORIGINS=
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-generated-secret
# Linux: TLS files must be readable by this numeric user/group; private key mode 0600 or 0640.
WEB_UID=101
WEB_GID=101
RUNNER_ENABLED=false
RUNNER_BASE_URL=http://host.docker.internal:8091
RUNNER_INTERNAL_KEY=
RUNNER_IMAGE_DIGEST=
