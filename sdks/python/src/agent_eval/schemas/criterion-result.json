{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "criterion-result",
  "$id": "urn:agenteval:v1:criterion-result",
  "type": "object",
  "properties": {
    "criterion_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "SCORED",
        "INSUFFICIENT_EVIDENCE",
        "ERROR",
        "SKIPPED",
        "WAITING_QUOTA"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "passed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluator_version": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  },
  "required": [
    "criterion_id",
    "status",
    "score",
    "passed",
    "reason",
    "evidence_refs",
    "evaluator_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SCORED"
          }
        }
      },
      "then": {
        "properties": {
          "score": {
            "type": "number"
          },
          "passed": {
            "type": "boolean"
          }
        }
      },
      "else": {
        "properties": {
          "score": {
            "type": "null"
          },
          "passed": {
            "type": "null"
          }
        }
      }
    }
  ]
}
